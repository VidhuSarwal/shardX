MONGO_URI=mongodb://localhost:27017/yourdb
JWT_SECRET=oohMySheela
TOKEN_ENC_KEY=32_byte_long_encryption_key_here!
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
BASE_URL=http://localhost:5555
# Web app origin; the OAuth callback redirects here (/oauth/finished). Defaults to BASE_URL.
FRONTEND_URL=http://localhost:5173

# Obfuscation settings
OBFUSCATION_BLOCK_SIZE=1024
OBFUSCATION_OVERHEAD_PCT=0.1
OBFUSCATION_MIN_GAP=100

# File processing settings
UPLOAD_TEMP_DIR=./tmp/uploads
MAX_FILE_SIZE_GB=1
SESSION_EXPIRY_HOURS=24
MAX_CONCURRENT_UPLOADS_PER_USER=3
TEMP_FILE_CLEANUP_MINUTES=60


# ---- AWS-native mode (all optional; unset = original Drive/Mongo/JWT behavior) ----
# AWS_PROFILE=shardx
# AWS_REGION=us-east-1
# STORAGE_PROVIDER=s3            # drive | s3
# S3_BUCKET=shardx-prod-shards-<suffix>
# S3_KMS_KEY_ID=alias/shardx-shards
# DB_PROVIDER=mongo              # mongo | dynamodb
# DYNAMODB_TABLE_PREFIX=shardx
# AUTH_PROVIDER=custom           # custom | cognito
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# EVENT_BUS_NAME=shardx-events
# STATE_MACHINE_ARN=
# SQS_QUEUE_URL=                 # enables shard-upload retries (run cmd/shardworker alongside)
# S3_ENDPOINT_URL=http://localhost:4566   # LocalStack only
# SQS_ENDPOINT_URL=http://localhost:4566  # LocalStack only
